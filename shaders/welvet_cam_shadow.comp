#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer GyBuf {
  float gy[];
};
layout(set = 0, binding = 1) readonly buffer StBuf {
  float student[];
};
layout(set = 0, binding = 2) readonly buffer TeBuf {
  float teacher[];
};

layout(push_constant) uniform Push {
  uint n;
  double coef;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  double term = pc.coef * 2.0 * (double(student[i]) - double(teacher[i])) / double(pc.n);
  gy[i] = float(double(gy[i]) + term);
}
