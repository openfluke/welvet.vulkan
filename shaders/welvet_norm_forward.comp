#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer XBuf {
  float x[];
};
layout(set = 0, binding = 1) readonly buffer GammaBuf {
  double gamma[];
};
layout(set = 0, binding = 2) readonly buffer BetaBuf {
  double beta[];
};
layout(set = 0, binding = 3) writeonly buffer PreBuf {
  float pre[];
};
layout(set = 0, binding = 4) writeonly buffer PostBuf {
  float post[];
};

layout(push_constant) uniform Push {
  int n_tok;
  int dim;
  double eps;
  int center;
  int has_beta;
} pc;

void main() {
  uint t = gl_GlobalInvocationID.x;
  if (int(t) >= pc.n_tok) return;
  int base = int(t) * pc.dim;
  double sum = 0.0;
  double sum_sq = 0.0;
  for (int i = 0; i < pc.dim; ++i) {
    double v = double(x[base + i]);
    sum += v;
    sum_sq += v * v;
  }
  double inv;
  double mean = 0.0;
  if (pc.center != 0) {
    mean = sum / double(pc.dim);
    double var_ = sum_sq / double(pc.dim) - mean * mean;
    inv = 1.0 / sqrt(var_ + pc.eps);
  } else {
    inv = 1.0 / sqrt(sum_sq / double(pc.dim) + pc.eps);
  }
  for (int i = 0; i < pc.dim; ++i) {
    double xv = double(x[base + i]);
    double xh = pc.center != 0 ? (xv - mean) * inv : xv * inv;
    pre[base + i] = float(xh);
    double y = xh * gamma[i];
    if (pc.center != 0 && pc.has_beta != 0) y += beta[i];
    post[base + i] = float(y);
  }
}
