#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

#include "welvet_activate.inc"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer GateBuf {
  float gate_pre[];
};
layout(set = 0, binding = 1) readonly buffer UpBuf {
  float up_post[];
};
layout(set = 0, binding = 2) writeonly buffer HBuf {
  float h[];
};

layout(push_constant) uniform Push {
  int n;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (int(i) >= pc.n) return;
  float silu_f = float(welvet_activate_dev(1, double(gate_pre[i])));
  h[i] = float(double(silu_f) * double(up_post[i]));
}
