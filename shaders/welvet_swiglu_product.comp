#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

#include "welvet_softdouble.inc"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer GateBuf {
  float gate_pre[];
};
layout(set = 0, binding = 1) readonly buffer UpBuf {
  float up_post[];
};
layout(set = 0, binding = 2) writeonly buffer HBuf {
  float h[];
};

layout(push_constant) uniform Push {
  int n;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (int(i) >= pc.n) return;
  // Metal/act_value SiLU: soft-double x * sigmoid(x) → f32, then * up.
  vec2 x = vec2(gate_pre[i], 0.0);
  float silu = sd_to_float(sd_mul(x, sd_sigmoid(x)));
  h[i] = float(double(silu) * double(up_post[i]));
}
