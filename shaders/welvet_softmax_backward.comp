#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer PreBuf {
  float pre[];
};
layout(set = 0, binding = 1) readonly buffer GyBuf {
  float gy[];
};
layout(set = 0, binding = 2) writeonly buffer GxBuf {
  float gx[];
};
layout(set = 0, binding = 3) readonly buffer MaskBuf {
  int mask[];
};

layout(push_constant) uniform Push {
  int rows;
  int cols;
  int kind;
  int mask_len;
  double temperature;
  int has_mask;
} pc;

void main() {
  uint tid = gl_GlobalInvocationID.x;
  if (int(tid) >= pc.rows) return;
  int start = int(tid) * pc.cols;
  double inv_t = 1.0 / (pc.temperature == 0.0 ? 1.0 : pc.temperature);
  float dot = 0.0;
  for (int i = 0; i < pc.cols; ++i) {
    float g = gy[start + i];
    if (pc.kind == 3 && pc.has_mask != 0 && start + i < pc.mask_len && mask[start + i] == 0) g = 0.0;
    dot += g * pre[start + i];
  }
  for (int j = 0; j < pc.cols; ++j) {
    float g = gy[start + j];
    if (pc.kind == 3 && pc.has_mask != 0 && start + j < pc.mask_len && mask[start + j] == 0) g = 0.0;
    float gl = pre[start + j] * (g - dot);
    gx[start + j] = float(double(gl) * inv_t);
  }
}
