#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

#include "welvet_activate.inc"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer GateBuf {
  float gate_pre[];
};
layout(set = 0, binding = 1) readonly buffer UpBuf {
  float up_post[];
};
layout(set = 0, binding = 2) readonly buffer GradHBuf {
  float grad_h[];
};
layout(set = 0, binding = 3) writeonly buffer DUpBuf {
  float d_up[];
};
layout(set = 0, binding = 4) writeonly buffer DGateBuf {
  float d_gate[];
};

layout(push_constant) uniform Push {
  int n;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (int(i) >= pc.n) return;
  double gp = double(gate_pre[i]);
  float silu_f = float(welvet_activate_dev(1, gp));
  float dsilu_f = float(welvet_activate_deriv_dev(1, gp));
  double dh = double(grad_h[i]);
  double up = double(up_post[i]);
  d_up[i] = float(dh * double(silu_f));
  d_gate[i] = float(dh * up * double(dsilu_f));
}
