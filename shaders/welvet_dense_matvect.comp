#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer WBuf {
  double W[];
};
layout(set = 0, binding = 1) readonly buffer DPreBuf {
  float d_pre[];
};
layout(set = 0, binding = 2) writeonly buffer GxBuf {
  float gx[];
};

layout(push_constant) uniform Push {
  int batch;
  int out_dim;
  int in_dim;
} pc;

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint n = uint(pc.batch * pc.in_dim);
  if (idx >= n) return;
  uint b = idx / uint(pc.in_dim);
  uint i = idx - b * uint(pc.in_dim);
  uint gyoff = b * uint(pc.out_dim);
  double sum = 0.0;
  for (int o = 0; o < pc.out_dim; ++o) {
    sum += W[uint(o) * uint(pc.in_dim) + i] * double(d_pre[gyoff + uint(o)]);
  }
  gx[idx] = float(sum);
}
