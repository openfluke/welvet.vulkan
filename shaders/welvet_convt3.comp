#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

#include "welvet_activate.inc"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer XBuf {
  float x[];
};
layout(set = 0, binding = 1) readonly buffer WBuf {
  float w[];
};
layout(set = 0, binding = 2) writeonly buffer PreBuf {
  float pre[];
};
layout(set = 0, binding = 3) writeonly buffer PostBuf {
  float post[];
};

layout(push_constant) uniform Push {
  int batch;
  int in_c;
  int filters;
  int in_d;
  int in_h;
  int in_w;
  int out_d;
  int out_h;
  int out_w;
  int kernel;
  int stride;
  int padding;
  int act;
} pc;

void main() {
  uint tid = gl_GlobalInvocationID.x;
  int sp_out = pc.out_d * pc.out_h * pc.out_w;
  int n_out = pc.batch * pc.filters * sp_out;
  if (int(tid) >= n_out) return;
  int sp_in = pc.in_d * pc.in_h * pc.in_w;
  int kkk = pc.kernel * pc.kernel * pc.kernel;
  int b = int(tid) / (pc.filters * sp_out);
  int rem = int(tid) - b * pc.filters * sp_out;
  int f = rem / sp_out;
  int o = rem - f * sp_out;
  int od = o / (pc.out_h * pc.out_w);
  int o2 = o - od * pc.out_h * pc.out_w;
  int oh = o2 / pc.out_w;
  int ow = o2 - oh * pc.out_w;
  double sum = 0.0;
  for (int ic = 0; ic < pc.in_c; ++ic) {
    for (int id = 0; id < pc.in_d; ++id) {
      for (int ih = 0; ih < pc.in_h; ++ih) {
        for (int iw = 0; iw < pc.in_w; ++iw) {
          double xv = double(x[b * pc.in_c * sp_in + ic * sp_in + id * pc.in_h * pc.in_w +
                              ih * pc.in_w + iw]);
          for (int kd = 0; kd < pc.kernel; ++kd) {
            for (int kh = 0; kh < pc.kernel; ++kh) {
              for (int kw = 0; kw < pc.kernel; ++kw) {
                if (id * pc.stride - pc.padding + kd != od ||
                    ih * pc.stride - pc.padding + kh != oh ||
                    iw * pc.stride - pc.padding + kw != ow) {
                  continue;
                }
                int kw_idx = f * pc.in_c * kkk + ic * kkk + kd * pc.kernel * pc.kernel +
                             kh * pc.kernel + kw;
                sum += xv * double(w[kw_idx]);
              }
            }
          }
        }
      }
    }
  }
  float p = float(sum);
  pre[tid] = p;
  post[tid] = float(welvet_activate_dev(pc.act, double(p)));
}
