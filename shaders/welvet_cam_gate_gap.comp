#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer GyBuf {
  float gy[];
};
layout(set = 0, binding = 1) writeonly buffer OutBuf {
  float out_data[];
};

layout(push_constant) uniform Push {
  uint n;
  uint out_n;
} pc;

void main() {
  uint tid = gl_GlobalInvocationID.x;
  if (tid >= pc.out_n) return;
  double sum = 0.0;
  for (uint i = 0u; i < pc.n; ++i) sum += double(gy[i]);
  out_data[tid] = float((sum / double(pc.n)) * 0.1);
}
